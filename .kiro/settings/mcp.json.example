{
  "mcpServers": {
    "mysql-server": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-mysql@latest"
      ],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "CHANGE_ME",
        "MYSQL_PASS": "CHANGE_ME",
        "MYSQL_DB": "CHANGE_ME"
      },
      "autoApprove": [
        "mysql_query"
      ]
    }
  }
}
