# Copy this file to .env and fill in the values. The .env file is not versioned.
# Used by docker-compose.yml and run-local.sh.

# Non-secret values (run-local.sh falls back to these defaults)
DB_USERNAME=financialbudgetuser
DB_DATABASE=financialbudgetdb

# Secrets: choose your own values; never commit them
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
